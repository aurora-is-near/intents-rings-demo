# Aurora Intents (mainnet — Leg A)
AURORA_API_KEY=
AURORA_CONNECT_API=https://intents-connect-api.aurora.dev
ORIGIN_CHAIN=base
ORIGIN_WALLET=0x0000000000000000000000000000000000000000
# Only needed for probes that submit. Use a throwaway key with dust.
ORIGIN_PRIVATE_KEY=

# Helius Rings (Leg B). Live on mainnet since 2026-10-30; set devnet to move back.
RINGS_NETWORK=mainnet
HELIUS_API_KEY=
# Leave blank to use the public RPC. Set HELIUS_API_KEY and this is built for you.
SOLANA_RPC=
# Photon indexer and Nitro prover, per network. Blank uses the built-in defaults.
# mainnet: https://dgcj4pjarvo65.cloudfront.net / https://d3ky2kt0ntqxt1.cloudfront.net
# devnet:  https://d34xe1hqb2ibg2.cloudfront.net / https://dd73hh473h6ha.cloudfront.net
PHOTON_RPC=
NITRO_PROVER=

# The recipient whose Rings balance we deposit into (must be registered)
RECIPIENT_SOLANA_ADDRESS=
