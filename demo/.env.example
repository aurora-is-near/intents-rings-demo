# Reown (WalletConnect) project id — free at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=

# Aurora key stays SERVER-SIDE. Vite proxies /api -> Aurora and injects it,
# so it is never shipped to the browser. Note the missing VITE_ prefix.
AURORA_API_KEY=

# Rings cluster for the registry + deposit leg. Mainnet since 2026-10-30.
# Set to devnet to point the proxy and examples back at the test cluster.
RINGS_NETWORK=mainnet

# A real Solana RPC provider. Optional in development, but any deployment needs
# one: api.mainnet-beta.solana.com rate-limits hard and blocks datacenter ranges,
# so the registry lookup can fail from a serverless function. The URL carries an
# API key, so it is server-side only -- never VITE_-prefixed.
SOLANA_RPC_URL=

# Set once the app has a domain. Unset means any origin may call the proxy.
ALLOWED_ORIGIN=
